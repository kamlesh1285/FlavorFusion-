DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=flavorfusion
# Set to "true" only when connecting to a hosted Postgres (Railway,
# Render, etc.) that requires SSL. Leave unset/false for local dev.
DATABASE_SSL=false

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3001

# UPI payments: real deep link/QR generated from your own UPI ID.
UPI_ID=yourname@upi
UPI_PAYEE_NAME=Your Restaurant Name
